# Supabase — from your project dashboard.
# Copy this file to .env.local and fill it in. .env.local is gitignored; never commit it.

# Project Settings -> Data API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# Older projects call this the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
# Safe to expose in the browser: row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> "Secret key" (sb_secret_...)
# Older name SUPABASE_SERVICE_ROLE_KEY also works. Bypasses row level security.
# NOT needed by the deployed app — only by the local scripts (npm run check / library).
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- deployment

# The public address of the site, e.g. https://resume-builder.ujesh.in
# Set this in production. It keeps auth redirects on https behind a reverse proxy, and it is
# the address Supabase confirmation emails send people back to. Without it they land on
# localhost. Leave blank for local development.
APP_ORIGIN=

# ---------------------------------------------------------------- optional

# GitHub token (classic, no scopes needed — it only reads public data).
# Raises the "import from GitHub" rate limit from 60 requests/hour per server to 5,000.
# One import costs about 15, so without this a shared deployment runs dry almost immediately.
GITHUB_TOKEN=

# A shared model for students with no API key of their own. Leave both blank to switch the
# option off entirely (it then disappears from the UI).
#   SHARED_AI_TOKEN      — e.g. a Hugging Face token (hf_...). YOU pay for this usage.
#   NEXT_PUBLIC_SHARED_AI — set to 1 to show the option. Must be set at BUILD time.
SHARED_AI_TOKEN=
NEXT_PUBLIC_SHARED_AI=
# Defaults to Hugging Face's router. Any OpenAI-compatible endpoint works.
# SHARED_AI_BASE_URL=https://router.huggingface.co/v1
# SHARED_AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
# SHARED_AI_HOURLY_LIMIT=12

# Optional: absolute path to pdflatex if it is not on PATH (Windows/MiKTeX usually is).
# PDFLATEX=

# Optional: how many LaTeX compiles may run at once on the server. Default 2.
# COMPILE_CONCURRENCY=2
