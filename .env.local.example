# Supabase — from your project dashboard.
# Copy this file to .env.local and fill it in. .env.local is gitignored; never commit it.

# Project Settings -> Data API -> "Project URL"
# e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# Older projects call this the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
# Safe to expose in the browser: row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> "Secret key" (sb_secret_...)
# Older projects call this "service_role"; SUPABASE_SERVICE_ROLE_KEY also works.
# Bypasses row level security. NEVER expose this to the browser and never commit it.
# Only used by scripts/library.ts and scripts/check-setup.ts.
SUPABASE_SECRET_KEY=

# Optional: absolute path to pdflatex if it is not on PATH (Windows/MiKTeX usually is).
# PDFLATEX=

# Optional: how many LaTeX compiles may run at once on the server. Default 2.
# COMPILE_CONCURRENCY=2
