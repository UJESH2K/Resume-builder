# Supabase — from your project dashboard.
# Copy this file to .env.local and fill it in. .env.local is gitignored; never commit it.

# Project Settings -> Data API -> "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# Older projects call this the "anon" key; NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
# Safe to expose in the browser: row level security is what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> "Secret key" (sb_secret_...)
# Older name SUPABASE_SERVICE_ROLE_KEY also works. Bypasses row level security.
# NOT needed by the deployed app — only by the local scripts (npm run check / library).
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- deployment

# The public address of the site, e.g. https://resume-builder.ujesh.in
# Set this in production. It keeps auth redirects on https behind a reverse proxy, and it is
# the address Supabase confirmation emails send people back to. Without it they land on
# localhost. Leave blank for local development.
APP_ORIGIN=

# ---------------------------------------------------------------- optional

# GitHub token (classic, no scopes needed — it only reads public data).
# Raises the "import from GitHub" rate limit from 60 requests/hour per server to 5,000.
# SET THIS BEFORE ANY SHARED USE. The limit is per server IP, not per student, and one import
# now costs about 40 requests (one per repo README) — so without a token the FIRST student to
# import exhausts the hour for everyone behind them.
GITHUB_TOKEN=

# How many repositories one import reads, and how much of each README. Defaults 40 / 2200.
# Lower them if imports are timing out; raise GITHUB_MAX_REPOS for people with large profiles.
# GITHUB_MAX_REPOS=40
# GITHUB_README_CHARS=2200

# A shared model for students with no API key of their own. Leave both blank to switch the
# option off entirely (it then disappears from the UI).
#   SHARED_AI_TOKEN      — e.g. a Hugging Face token (hf_...). YOU pay for this usage.
#   NEXT_PUBLIC_SHARED_AI — set to 1 to show the option. Must be set at BUILD time.
SHARED_AI_TOKEN=
NEXT_PUBLIC_SHARED_AI=
# Defaults to Hugging Face's router. Any OpenAI-compatible endpoint works.
# SHARED_AI_BASE_URL=https://router.huggingface.co/v1
# SHARED_AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
# SHARED_AI_HOURLY_LIMIT=12

# Optional: absolute path to pdflatex if it is not on PATH (Windows/MiKTeX usually is).
# PDFLATEX=

# ---------------------------------------------------------------- the demo account
#
# One shared login, handed to a room of people so they can look around a filled-in resume
# without signing up. Leave DEMO_EMAIL blank and there is no demo account at all.
#
# DEMO_EMAIL     the address it authenticates with. Never shown to students, but it must be a
#                real, unique address because Supabase signs in on it.
# DEMO_USERNAME  what students actually type in the email box. Mapped to DEMO_EMAIL server-side.
# DEMO_PASSWORD  typed out on a projector, so treat this account as public. It holds a COPY of
#                a library and can never reach the account it was copied from.
#
# Create it with:  node scripts/demo.ts setup your-real@email.com
DEMO_EMAIL=
DEMO_USERNAME=demo
DEMO_PASSWORD=

# ---------------------------------------------------------------- compile tuning
#
# Compiling is the only expensive thing the server does: one preview is 3-5 pdflatex runs.
# These matter when a class uses the app at once.

# How many LaTeX compiles may run at once. Default 2. Raise it only if the box has the cores —
# each run is CPU-bound, and oversubscribing makes everyone slower, not faster.
# COMPILE_CONCURRENCY=2

# How many requests may wait for a slot before the server starts answering "busy" (503)
# instead of queueing them invisibly. Default 60.
# COMPILE_QUEUE_MAX=60

# How long a request waits for a slot before giving up. Default 25000ms.
# COMPILE_QUEUE_WAIT_MS=25000

# Hard ceiling on one pdflatex run. Default 30000ms.
# COMPILE_TIMEOUT_MS=30000

# Finished PDFs kept in memory, keyed by the exact LaTeX that produced them. Default 150.
# This is what makes a repeat preview free; set to 0 to disable.
# COMPILE_CACHE_MAX=150

# Compiles allowed per student per minute. Default 30.
# COMPILE_RATE_PER_MIN=30
